# App security
CRON_SECRET=replace-with-at-least-16-random-characters
ADMIN_API_KEY=replace-with-a-long-random-key
NEXT_PUBLIC_GITHUB_URL=https://github.com/mherzog4/signalbrief

# AI — choose openrouter, openai, or anthropic
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-5-mini
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=Signalbrief
OPENROUTER_APP_URL=https://signalbrief-alpha.vercel.app
OPENAI_API_KEY=
# Optional: OpenRouter, Groq, or another OpenAI-compatible endpoint
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# Calendar — Google Calendar v3 bearer token (single-workspace v1)
GOOGLE_CALENDAR_ID=primary
# Use either a short-lived access token or all three renewable OAuth values.
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
INTERNAL_DOMAINS=yourcompany.com
LOOKAHEAD_MINUTES=45

# Revenue sources
GONG_ACCESS_KEY=
GONG_ACCESS_SECRET=
GONG_API_BASE_URL=https://api.gong.io
HUBSPOT_ACCESS_TOKEN=

# Public web research — Tavily Search API
TAVILY_API_KEY=

# Delivery — Slack incoming webhook
SLACK_WEBHOOK_URL=
# Bot delivery supports DMs; requires chat:write and im:write scopes
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Optional JSON map from calendar organizer email to Slack member ID
SLACK_USER_MAP={}

# Optional durable idempotency (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Demo and delivery controls
DEMO_MODE=true
DEMO_USE_LIVE_AI=false
# Explicitly allow the public demo action to post to configured Slack delivery.
DEMO_SLACK_DELIVERY_ENABLED=false
DEMO_RATE_LIMIT_PER_MINUTE=12
DRY_RUN=false
